<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Website</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: #f8fafc;
      text-align: center;
    }

    header {
      padding: 60px 20px;
      background: linear-gradient(135deg, #4f46e5, #06b6d4);
    }

    h1 {
      font-size: 40px;
      margin: 0;
    }

    p {
      font-size: 18px;
      opacity: 0.9;
    }

    .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 20px;
      background: white;
      color: black;
      border-radius: 10px;
      text-decoration: none;
      font-weight: bold;
    }

    section {
      padding: 40px 20px;
    }

    .card {
      background: #1e293b;
      margin: 20px auto;
      padding: 20px;
      max-width: 500px;
      border-radius: 15px;
    }

    footer {
      padding: 20px;
      font-size: 12px;
      opacity: 0.6;
    }
  </style>
</head>
<body>

  <header>
    <h1>Welcome to My Website 🚀</h1>
    <p>A simple website made with GitHub Pages</p>
    <a class="btn" href="#about">Learn More</a>
  </header>

  <section id="about">
    <div class="card">
      <h2>About</h2>
      <p>This is your free website. You can edit this text, add images, or turn it into a business site.</p>
    </div>

    <div class="card">
      <h2>My Idea</h2>
      <p>You can use this for a business, portfolio, or school project.</p>
    </div>
  </section>

  <footer>
    Made with GitHub Pages 💻
  </footer>

</body>
</html>
